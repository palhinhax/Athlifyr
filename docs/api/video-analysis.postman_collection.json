            "description": "Análise corporal COM AI em Português."
          }
        },
        {
          "name": "Analyze Body + AI (EN) - Railway",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "video",
                  "type": "file",
                  "src": "",
                  "description": "Vídeo de qualquer ângulo (.mp4, .mov, .avi)"
                },
                { "key": "show_angles", "value": "true", "type": "text" },
                {
                  "key": "enable_ai",
                  "value": "true",
                  "type": "text",
                  "description": "AI activada"
                },
                {
                  "key": "language",
                  "value": "en",
                  "type": "text",
                  "description": "Resposta em English"
                }
              ]
            },
            "url": {
              "raw": "{{railway_url}}/analyze/body",
              "host": ["{{railway_url}}"],
              "path": ["analyze", "body"]
            },
            "description": "Análise corporal COM AI em Inglês."
          }
        }
      ]
    },
    {
      "name": "Analyze Full (URL)",
      "description": "🆕 Análise completa via URL presigned (Backblaze B2).\nO servidor descarrega o vídeo — Vercel envia apenas JSON (~1 KB).\nEndpoint: POST /analyze/full/url",
      "item": [
        {
          "name": "Analyze Full URL - Railway",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_url\": \"{{test_video_url}}\",\n  \"content_type\": \"video/mp4\",\n  \"seed_x\": 0.52,\n  \"seed_y\": 0.38,\n  \"seed_frame\": 0,\n  \"show_angles\": true,\n  \"max_duration_sec\": 30,\n  \"auto_detect\": true,\n  \"enable_ai\": false,\n  \"language\": \"en\",\n  \"result_upload_url\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{railway_url}}/analyze/full/url",
              "host": ["{{railway_url}}"],
              "path": ["analyze", "full", "url"]
            },
            "description": "Análise completa via URL (sem AI). Substituir test_video_url por uma presigned URL B2 válida."
          }
        },
        {
          "name": "Analyze Full URL + AI (PT) - Railway",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_url\": \"{{test_video_url}}\",\n  \"content_type\": \"video/mp4\",\n  \"seed_x\": 0.52,\n  \"seed_y\": 0.38,\n  \"seed_frame\": 0,\n  \"show_angles\": true,\n  \"max_duration_sec\": 30,\n  \"auto_detect\": true,\n  \"enable_ai\": true,\n  \"language\": \"pt\",\n  \"result_upload_url\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{railway_url}}/analyze/full/url",
              "host": ["{{railway_url}}"],
              "path": ["analyze", "full", "url"]
            },
            "description": "Análise completa via URL COM AI em Português."
          }
        },
        {
          "name": "Analyze Full URL + Trim - Railway",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_url\": \"{{test_video_url}}\",\n  \"content_type\": \"video/mp4\",\n  \"seed_x\": 0.52,\n  \"seed_y\": 0.38,\n  \"seed_frame\": 0,\n  \"show_angles\": true,\n  \"max_duration_sec\": 30,\n  \"auto_detect\": true,\n  \"enable_ai\": false,\n  \"language\": \"en\",\n  \"trim_start_sec\": 2.0,\n  \"trim_end_sec\": 8.0,\n  \"result_upload_url\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{railway_url}}/analyze/full/url",
              "host": ["{{railway_url}}"],
              "path": ["analyze", "full", "url"]
            },
            "description": "Análise completa via URL com trim (corta o vídeo entre 2s e 8s antes de processar)."
          }
        }
      ]
    },
