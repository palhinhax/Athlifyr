            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_url\": \"{{test_video_url}}\",\n  \"content_type\": \"video/webm\",\n  \"show_angles\": true,\n  \"max_duration_sec\": 30,\n  \"enable_ai\": false,\n  \"language\": \"en\",\n  \"result_upload_url\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{railway_url}}/analyze/body/url",
              "host": ["{{railway_url}}"],
