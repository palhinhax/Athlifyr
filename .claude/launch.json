{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Web App",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000
    },
    {
      "name": "Live Server (Fastify + Socket.io)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["live:dev"],
      "port": 4000
    },
    {
      "name": "Mobile App (Expo)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "mobile", "start"],
      "port": 8081
    },
    {
      "name": "Prisma Studio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["db:studio"],
      "port": 5555
    },
    {
      "name": "Scraping Service (FastAPI)",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["app.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000
    }
  ]
}
