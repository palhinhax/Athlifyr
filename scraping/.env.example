# Scraping service env
SCRAPING_DATABASE_URL=postgresql+asyncpg://localhost:5432/athlifyr_scraping

# Storage — local or S3-compatible (e.g. Backblaze B2)
SCRAPING_STORAGE_BACKEND=local
SCRAPING_STORAGE_LOCAL_PATH=./data/documents
SCRAPING_STORAGE_S3_BUCKET=
SCRAPING_STORAGE_S3_REGION=
SCRAPING_STORAGE_S3_ENDPOINT=
SCRAPING_STORAGE_S3_ACCESS_KEY=
SCRAPING_STORAGE_S3_SECRET_KEY=

# Scheduler
SCRAPING_SCHEDULER_ENABLED=true
SCRAPING_SCHEDULER_DEFAULT_INTERVAL_HOURS=24
SCRAPING_DEBUG=false

# Shared API key with Next.js (leave empty for local dev without auth)
# Generate with: openssl rand -base64 32
SCRAPING_API_KEY=

# AI Event Generation (OpenAI → Next.js import)
# Uses OpenAI to generate a full event JSON from scraped data + documents
SCRAPING_OPENAI_API_KEY=
SCRAPING_OPENAI_MODEL=gpt-4o-mini
SCRAPING_NEXTJS_URL=http://localhost:3000
# Must match EVENT_IMPORT_SECRET in the Next.js .env
# Generate with: openssl rand -base64 32
SCRAPING_NEXTJS_IMPORT_SECRET=
