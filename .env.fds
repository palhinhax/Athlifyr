# # ============================================
# # APPLICATION
# # ============================================
# NODE_ENV="development"
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# # ============================================
# # NEXTAUTH
# # ============================================
# # Gera uma nova secret com: openssl rand -base64 32
# NEXTAUTH_SECRET="nQ8JFMSBLEmZpZtiIcjfRSJz86t01zU8iSPQQALryvg="
# NEXTAUTH_URL="http://localhost:3000"

# # ============================================
# # GOOGLE OAUTH
# # ============================================
# # Para usar credenciais diferentes localmente:
# # GOOGLE_CLIENT_ID="your-local-google-client-id"
# # GOOGLE_CLIENT_SECRET="your-local-google-client-secret"

# # ============================================
# # GOOGLE ANALYTICS
# # ============================================
# # Desativado por defeito em desenvolvimento
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# # ============================================
# # BACKBLAZE B2 STORAGE
# # ============================================
# # Para usar um bucket diferente localmente:
# # B2_APPLICATION_KEY_ID="your-local-b2-key-id"
# # B2_APPLICATION_KEY="your-local-b2-key"
# # B2_BUCKET_ID="your-local-bucket-id"
# # B2_BUCKET_NAME="your-local-bucket-name"
# # NEXT_PUBLIC_B2_BUCKET_URL="https://f003.backblazeb2.com"

# # ============================================
# # RESEND EMAIL
# # ============================================
# # Para usar uma chave de teste ou diferente:
# # RESEND_API_KEY="re_your_local_api_key"

# # Email remetente (opcional)
# # EMAIL_FROM="Athlifyr <noreply@athlifyr.com>"

# # ============================================
# # STRIPE
# # ============================================
# # Para usar chaves de teste diferentes:
# # STRIPE_SECRET_KEY="sk_test_your_local_key"
# # NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_local_key"

# # Webhook secret para desenvolvimento local com Stripe CLI
# # Corre: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# # STRIPE_WEBHOOK_SECRET="whsec_your_local_webhook_secret"

# # ============================================
# # OPENWEATHER
# # ============================================
# # OPENWEATHER_API_KEY="your-local-openweather-key"

# # ============================================
# # MAINTENANCE MODE
# # ============================================
# # MAINTENANCE_MODE="false"

# # ============================================
# # WEATHER UPDATE
# # ============================================
# # WEATHER_UPDATE_SECRET="your-local-secret"

# # ============================================
# # FEATURE FLAGS (opcional)
# # ============================================
# # NEXT_PUBLIC_INSTAGRAM_EXPORT_ENABLED="true"
# # NEXT_PUBLIC_DEBUG_MODE="true"
