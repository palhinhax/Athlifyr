model Venue {
  id                                 String                  @id @default(cuid())
  slug                               String                  @unique
  name                               String
  type                               VenueType
  sportTypes                         SportType[]
  services                           VenueService[]          @default([])
  description                        String?
  phone                              String?
  email                              String?
  website                            String?
  instagram                          String?
  whatsapp                           String?
  address                            String?
  city                               String?
  country                            String                  @default("Portugal")
  latitude                           Float?
  longitude                          Float?
  paymentMode                        PaymentMode             @default(MIXED)
  externalPaymentInstructions        String?
  createdByUserId                    String
  isVerified                         Boolean                 @default(false)
  isActive                           Boolean                 @default(true)
  createdAt                          DateTime                @default(now())
  updatedAt                          DateTime                @updatedAt
  coverImage                         String?
  logo                               String?
  defaultBookingAdvanceDays          Int                     @default(4)
  defaultBookingDeadlineMinutes      Int                     @default(0) // How many minutes before session booking closes (0 = book until session starts)
  defaultCancellationDeadlineMinutes Int                     @default(30)
  defaultSessionCapacity             Int?
  commissionType                     CommissionType          @default(PERCENT)
  commissionValue                    Int                     @default(0)
  paymentsProvider                   PaymentsProvider        @default(NONE)
  stripeAccountId                    String?                 @unique
  stripeChargesEnabled               Boolean                 @default(false)
  stripeDetailsSubmitted             Boolean                 @default(false)
  stripeLastWebhookAt                DateTime?
  stripeOnboardingStatus             StripeOnboardingStatus  @default(NOT_STARTED)
  stripePayoutsEnabled               Boolean                 @default(false)
  requiresPlanToBook                 Boolean                 @default(true)
  enableTrialBooking                 Boolean                 @default(false)
  visibleTabs                        String[]                @default(["feed", "about", "plans", "sessions", "team", "clients", "subscriptions"])
  paymentIntents                     PaymentIntent[]
  posts                              Post[]
  bookings                           VenueBooking[]
  invites                            VenueInvite[]
  members                            VenueMember[]
  ownershipClaims                    VenueOwnershipClaim[]
  plans                              VenuePlan[]
  includedInPlans                    VenuePlanVenue[] // Plans from other venues that include this venue
  recommendations                    VenueRecommendation[]
  recurringSessions                  VenueRecurringSession[]
  reviews                            VenueReview[]
  sessions                           VenueSession[]
  subscriptions                      VenueSubscription[]
  images                             VenueImage[]
  featuredInEvents                   Event[]                 @relation("FeaturedVenue")

  translations VenueTranslation[]

  // Workout Builder relations
  workouts      Workout[]
  trainingPlans TrainingPlan[]
  sessionPlans  VenueSessionPlan[]

  @@index([slug])
  @@index([type])
  @@index([city])
  @@index([isActive])
  @@index([createdByUserId])
  @@index([sportTypes])
}

model VenueImage {
