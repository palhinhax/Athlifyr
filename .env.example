# Database
# PostgreSQL connection string for Prisma
# For Neon, use the pooled connection string (ends with ?pgbouncer=true)
DATABASE_URL="postgresql://postgres:password@localhost:5432/athlifyr?pgbouncer=true"
# For Neon, use the direct connection string (for migrations)
DIRECT_URL="postgresql://postgres:password@localhost:5432/athlifyr"

# Application Environment
# Options: development, production, test
NODE_ENV="development"

# Maintenance Mode
# Set to "true" to enable maintenance mode (shows maintenance page to all users)
# Set to "false" or remove to disable maintenance mode
MAINTENANCE_MODE="false"

# Application URL
# Used for SEO, sitemaps, and robots.txt
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
# IMPORTANT: Use canonical domain WITH www for production
# This prevents "invalid_grant" errors from Google OAuth
NEXTAUTH_URL="http://localhost:3000"  # Dev: http://localhost:3000 | Prod: https://www.athlifyr.com

# Google OAuth
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Required scopes: email, profile
# CRITICAL: Callback URL MUST match NEXTAUTH_URL
# Dev: http://localhost:3000/api/auth/callback/google
# Prod: https://www.athlifyr.com/api/auth/callback/google (WITH www!)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google OAuth Authentication Method
# Options: "nextauth" (default) or "rest-api"
# - nextauth: Uses NextAuth.js for automatic session management (recommended)
# - rest-api: Uses direct REST API endpoint (/api/auth/google-web) with JWT tokens
# Only change this if you're experiencing issues with NextAuth Google login
NEXT_PUBLIC_GOOGLE_AUTH_METHOD="nextauth"

# Google Analytics
# Get your Measurement ID from: https://analytics.google.com
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Resend
# Get your API key from: https://resend.com/api-keys
# Used for sending transactional emails (password reset, etc.)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# OpenWeatherMap API
# Get your free API key at: https://openweathermap.org/api
# Free tier: ~1,000 calls/day, 60 requests/minute
OPENWEATHER_API_KEY="your_openweathermap_api_key_here"

# Weather Update Security Token
# Generate a secure random string for the weather update endpoint
# This token is used by GitHub Actions to securely call the weather update API
# Example: openssl rand -hex 32
WEATHER_UPDATE_SECRET="your_secure_random_token_here"

# Web Push Notifications (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
# Public key is sent to browsers, private key stays on server
# Subject should be a mailto: or https: URL
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BAr4eyrVOovwOHHYgfZ-OT-5zzo9lMAYx-PoOpkUte2WyHEecOesDzqDbqEtX_-rRNoHHsVPduDN3JvvvgJX_YQ"
VAPID_PRIVATE_KEY="bVmDDwy3BaJnqjoqIZSNFCmVQ28OrcU36s402vn_a0k"
VAPID_SUBJECT="mailto:hello@athlifyr.com"

# Google Play Integrity API
# Used to verify that API requests come from a genuine Android app
# Package name must match your Android app's package name in app.json
GOOGLE_PLAY_PACKAGE_NAME="com.athlifyr.app"

# Google Service Account credentials JSON (for Play Integrity token decoding)
# Create a service account at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Grant it the "Service Account Token Creator" role
# Export the key as JSON and paste the entire JSON string here (single line)
GOOGLE_APPLICATION_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Sentry Error Monitoring
# Get your DSN from: https://sentry.io/settings/<org>/projects/<project>/keys/
# NEXT_PUBLIC_SENTRY_DSN is used by the browser bundle; SENTRY_DSN is used server-side.
# Both can point to the same Sentry project DSN.
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# Auth token for source map uploads (keep server-side only — never expose to browser)
# Generate at: https://sentry.io/settings/account/api/auth-tokens/
# Required scope: project:releases, org:read
SENTRY_AUTH_TOKEN="sntrys_your_auth_token_here"
SENTRY_ORG="your-sentry-org-slug"
SENTRY_PROJECT="athlifyr-web"

