  distanceKm     Float?
  timeSeconds    Int?
  elevationGainM Int?

  // Strength fields
  exerciseId String?
  weightKg   Float?
  reps       Int?

  // HYROX fields
  hyroxCategory HyroxCategory?
  eventName     String? // For manual entries or linked event name
  location      String?

  // Event Result link (when entry comes from an official event)
  resultId String? @unique

  // Workout Result link (when entry comes from a workout log)
  workoutExerciseResultId String?
  workoutExerciseSetId    String? @unique

  // Computed scores (persisted)
  qualityScore     Float @default(0.5)
  predictionWeight Float @default(0.5)

  // Link to GPS activity (when entry comes from a tracked run)
  runActivityId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id])
  result   Result?   @relation("ResultPerformance", fields: [resultId], references: [id], onDelete: Cascade)

  // Workout Builder relations
  workoutExerciseResult WorkoutExerciseResult? @relation("WorkoutResultPerformance", fields: [workoutExerciseResultId], references: [id])
  workoutExerciseSet    WorkoutExerciseSet?    @relation("SetPerformance", fields: [workoutExerciseSetId], references: [id])

  // GPS activity relation
  runActivity RunActivity? @relation(fields: [runActivityId], references: [id], onDelete: SetNull)

  @@index([userId, type, performedAt])
  @@index([userId, exerciseId])
  @@index([userId, hyroxCategory])
  @@index([resultId])
  @@index([workoutExerciseResultId])
}

model Exercise {
  id          String           @id @default(cuid())
  name        String
  aliases     String[]         @default([])
  category    ExerciseCategory @default(OTHER)
  effortScore Float            @default(5.0) // 1-10 scale: effort/intensity rating
  createdById String?
  isGlobal    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Measurement fields - which metrics make sense for this exercise
  hasReps     Boolean @default(true) // repetitions (e.g., squats, push-ups)
  hasWeight   Boolean @default(false) // weight used (e.g., deadlifts, bench press)
  hasDistance Boolean @default(false) // distance covered (e.g., running, rowing)
  hasTime     Boolean @default(false) // time taken/held (e.g., planks, running)
  hasCalories Boolean @default(false) // calories burned (e.g., rowing, assault bike)
  hasHeight   Boolean @default(false) // height (e.g., box jumps)

  createdBy    User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  entries      UserPerformanceEntry[]
  translations ExerciseTranslation[]

  // Workout Builder relations
  workoutBlockExercises  WorkoutBlockExercise[]
  workoutExerciseResults WorkoutExerciseResult[] @relation("WorkoutExerciseResults")

  @@index([name])
  @@index([createdById])
  @@index([isGlobal])
  @@index([effortScore])
}

model ExerciseTranslation {
  id          String   @id @default(cuid())
  exerciseId  String
  language    Language
  name        String
  aliases     String[] @default([])
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, language])
  @@index([exerciseId])
  @@index([language])
  @@index([name])
}

enum PerformanceEntryType {
  RUN
  TRAIL
  STRENGTH
  HYROX
}

enum HyroxCategory {
  OPEN_MEN
  OPEN_WOMEN
  PRO_MEN
  PRO_WOMEN
  ELITE_15_MEN
  ELITE_15_WOMEN
  DOUBLES_MEN
  DOUBLES_WOMEN
  DOUBLES_MIXED
  RELAY_MEN
  RELAY_WOMEN
  RELAY_MIXED
  AGE_GROUP_16_29_MEN
  AGE_GROUP_16_29_WOMEN
  AGE_GROUP_30_34_MEN
  AGE_GROUP_30_34_WOMEN
  AGE_GROUP_35_39_MEN
  AGE_GROUP_35_39_WOMEN
  AGE_GROUP_40_44_MEN
  AGE_GROUP_40_44_WOMEN
  AGE_GROUP_45_49_MEN
  AGE_GROUP_45_49_WOMEN
  AGE_GROUP_50_54_MEN
  AGE_GROUP_50_54_WOMEN
  AGE_GROUP_55_59_MEN
  AGE_GROUP_55_59_WOMEN
  AGE_GROUP_60_64_MEN
  AGE_GROUP_60_64_WOMEN
  AGE_GROUP_65_69_MEN
  AGE_GROUP_65_69_WOMEN
  AGE_GROUP_70_PLUS_MEN
  AGE_GROUP_70_PLUS_WOMEN
  ADAPTIVE
}

enum ExerciseCategory {
  CROSSFIT
  GYM
  WEIGHTLIFTING
  BODYWEIGHT
  CARDIO
  OTHER
}

// ============================================================================
// WORKOUT BUILDER - 100% Relacional (Integrado com Performance)
// ============================================================================

model Workout {
  id          String  @id @default(cuid())
  name        String
  description String?

  createdById String
  venueId     String? // Se criado para um venue específico

  estimatedTime Int? // Tempo estimado em minutos
  difficulty    Int? // 1-5 (dificuldade)
  tags          String[] @default([])
  isTemplate    Boolean  @default(false) // Pode ser reutilizado
  isPublic      Boolean  @default(false) // Visível para todos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy       User                  @relation("CreatedWorkouts", fields: [createdById], references: [id])
  venue           Venue?                @relation(fields: [venueId], references: [id])
  blocks          WorkoutBlock[]
  sessionWorkouts VenueSessionWorkout[]
  userWorkouts    UserWorkout[]
  logs            WorkoutLog[]
  planWorkouts    TrainingPlanWorkout[]
  savedBy         SavedWorkout[]
  posts           Post[] // Posts that feature this workout (WOD posts)

  @@index([createdById])
  @@index([venueId])
  @@index([isPublic])
}

model WorkoutBlock {
  id        String @id @default(cuid())
  workoutId String

  type       WorkoutBlockType
  name       String? // Nome opcional do bloco
  orderIndex Int // Ordem no treino (0, 1, 2...)

  // Timing (todos em segundos)
  timeCap  Int? // Para AMRAP, FOR_TIME
  workTime Int? // Para EMOM (tempo de trabalho por minuto)
  rounds   Int? // Número de rounds prescritos

  notes String?

  workout        Workout                @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercises      WorkoutBlockExercise[]
  exerciseGroups ExerciseGroup[]
  results        WorkoutBlockResult[]

  @@index([workoutId])
}

// Grupo de exercícios dentro de um bloco (para mini-circuits, rounds aninhados)
// Exemplo: "2 rounds: 10 air squats + 10 push-ups + 5 pull-ups"
model ExerciseGroup {
  id                String  @id @default(cuid())
  blockId           String
  name              String? // Nome opcional (ex: "Circuit A")
  orderIndex        Int // Posição no bloco (intercalado com exercícios soltos)
  rounds            Int     @default(1) // Número de rounds do grupo
  restBetweenRounds Int? // Descanso entre rounds (segundos)
  notes             String?

  block     WorkoutBlock           @relation(fields: [blockId], references: [id], onDelete: Cascade)
  exercises WorkoutBlockExercise[]

  @@index([blockId])
}

model WorkoutBlockExercise {
  id         String  @id @default(cuid())
  blockId    String
  groupId    String? // Se pertence a um grupo (opcional)
  exerciseId String // FK para Exercise
  orderIndex Int // Ordem no bloco/grupo (0, 1, 2...)

  // Prescrição - o que o coach prescreve (Male/Rx)
  prescribedReps          Int?
  prescribedWeight        Float?
  prescribedWeightUnit    WeightUnit?
  prescribedWeightPercent Float? // % do 1RM (alternativa ao peso fixo)
  prescribedDistance      Float?
  prescribedDistanceUnit  DistanceUnit?
  prescribedTime          Int? // segundos
  prescribedCalories      Int?
  prescribedSets          Int? // número de sets prescritos (para STRENGTH)

  // Prescrição Female (opcionais - quando diferente de Male)
  prescribedRepsFemale          Int?
  prescribedWeightFemale        Float?
  prescribedWeightUnitFemale    WeightUnit?
  prescribedWeightPercentFemale Float?
  prescribedDistanceFemale      Float?
  prescribedDistanceUnitFemale  DistanceUnit?
  prescribedTimeFemale          Int?
  prescribedCaloriesFemale      Int?
  prescribedSetsFemale          Int?

  notes String? // Notas específicas do exercício

  block            WorkoutBlock             @relation(fields: [blockId], references: [id], onDelete: Cascade)
  group            ExerciseGroup?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  exercise         Exercise                 @relation(fields: [exerciseId], references: [id])
  results          WorkoutExerciseResult[]
  setPrescriptions WorkoutSetPrescription[] // Prescrições variáveis por set

  @@index([blockId])
  @@index([groupId])
  @@index([exerciseId])
}

// Prescrição individual por set - permite diferentes reps/peso/% por set
// Exemplo: Set 1 = 5 reps @ 65%, Set 2 = 5 reps @ 70%, Set 3 = 3 reps @ 75%
model WorkoutSetPrescription {
  id              String @id @default(cuid())
  blockExerciseId String
  setNumber       Int // 1, 2, 3, 4...

  // Prescrição para este set específico - Male/Rx
  reps          Int? // null = max reps
  weight        Float? // Peso fixo (alternativa ao %)
  weightUnit    WeightUnit?
  weightPercent Float? // % do 1RM/PR
  time          Int? // Tempo em segundos
  distance      Float?
  distanceUnit  DistanceUnit?
  calories      Int?

  // Prescrição Female (opcionais - quando diferente de Male)
  repsFemale          Int?
  weightFemale        Float?
  weightUnitFemale    WeightUnit?
  weightPercentFemale Float?
  timeFemale          Int?
  distanceFemale      Float?
  distanceUnitFemale  DistanceUnit?
  caloriesFemale      Int?

  notes String? // Ex: "até falha técnica"

  blockExercise WorkoutBlockExercise @relation(fields: [blockExerciseId], references: [id], onDelete: Cascade)

  @@unique([blockExerciseId, setNumber])
  @@index([blockExerciseId])
}

// Atribuição de workout a uma sessão de venue
model VenueSessionWorkout {
  id         String   @id @default(cuid())
  sessionId  String
  workoutId  String
  assignedAt DateTime @default(now())
  notes      String? // Notas do coach para esta sessão específica

  session VenueSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workout Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([sessionId, workoutId])
  @@index([sessionId])
  @@index([workoutId])
}

// Atribuição de workout a um utilizador específico
model UserWorkout {
  id           String    @id @default(cuid())
  userId       String
  workoutId    String
  assignedById String? // Coach que atribuiu (null se auto-atribuído)
  scheduledFor DateTime? // Data agendada para fazer o treino
  notes        String? // Notas do coach

  createdAt DateTime @default(now())

  user       User    @relation("AssignedWorkouts", fields: [userId], references: [id], onDelete: Cascade)
  workout    Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  assignedBy User?   @relation("WorkoutAssigner", fields: [assignedById], references: [id])

  @@index([userId, scheduledFor])
  @@index([workoutId])
}

// ============================================================================
// WORKOUT LOG - Resultados do atleta (100% relacional)
// ============================================================================

model WorkoutLog {
  id        String  @id @default(cuid())
  userId    String
  workoutId String
  sessionId String? // Se foi feito numa sessão de venue

  performedAt DateTime @default(now())

  // Feedback geral do treino
  notes           String?
  feeling         Int? // 1-5 (como te sentiste)
  perceivedEffort Int? // RPE 1-10

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout      Workout              @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  session      VenueSession?        @relation(fields: [sessionId], references: [id])
  blockResults WorkoutBlockResult[]

  @@index([userId, performedAt])
  @@index([workoutId])
  @@index([sessionId])
}

model WorkoutBlockResult {
  id      String @id @default(cuid())
  logId   String
  blockId String

  // Resultados específicos por tipo de bloco
  completedRounds Int? // Para AMRAP - rounds completos
  extraReps       Int? // Para AMRAP - reps extra após último round completo
  completedTime   Int? // Para FOR_TIME - tempo total em segundos
  completedInTime Boolean? // Para EMOM - conseguiu completar dentro do tempo

  notes String?

  log             WorkoutLog              @relation(fields: [logId], references: [id], onDelete: Cascade)
  block           WorkoutBlock            @relation(fields: [blockId], references: [id])
  exerciseResults WorkoutExerciseResult[]

  @@index([logId])
  @@index([blockId])
}

model WorkoutExerciseResult {
  id              String @id @default(cuid())
  blockResultId   String
  blockExerciseId String // FK para WorkoutBlockExercise
  exerciseId      String // FK para Exercise (denormalizado para queries)

  // O que foi realmente feito (resumo - usado quando não há sets individuais)
  actualReps         Int?
  actualWeight       Float?
  actualWeightUnit   WeightUnit?
  actualDistance     Float?
  actualDistanceUnit DistanceUnit?
  actualTime         Int? // segundos
  actualCalories     Int?

  isPR Boolean @default(false) // Calculado automaticamente

  notes String?

  blockResult        WorkoutBlockResult     @relation(fields: [blockResultId], references: [id], onDelete: Cascade)
  blockExercise      WorkoutBlockExercise   @relation(fields: [blockExerciseId], references: [id])
  exercise           Exercise               @relation("WorkoutExerciseResults", fields: [exerciseId], references: [id])
  sets               WorkoutExerciseSet[] // Múltiplos sets (para STRENGTH)
  performanceEntries UserPerformanceEntry[] @relation("WorkoutResultPerformance")

  @@index([blockResultId])
  @@index([blockExerciseId])
  @@index([exerciseId])
}

// Sets individuais - para exercícios de força com múltiplos sets
model WorkoutExerciseSet {
  id               String @id @default(cuid())
  exerciseResultId String
  setNumber        Int // 1, 2, 3...

  reps       Int
  weight     Float
  weightUnit WeightUnit

  isPR  Boolean @default(false)
  notes String?

  exerciseResult   WorkoutExerciseResult @relation(fields: [exerciseResultId], references: [id], onDelete: Cascade)
  performanceEntry UserPerformanceEntry? @relation("SetPerformance")

  @@index([exerciseResultId])
}

// ============================================================================
// TRAINING PLANS (Planos de Treino)
// ============================================================================

// Plano de treino - coleção estruturada de workouts com progressão ao longo do tempo
// Exemplo: "CrossFit Iniciantes - 8 Semanas", "Preparação Maratona", "Força e Hipertrofia"
model TrainingPlan {
  id          String  @id @default(cuid())
  name        String // "CrossFit Iniciantes - 8 Semanas"
  description String? // Descrição detalhada do plano
  imageUrl    String? // Imagem de capa do plano

  createdById String
  venueId     String? // Se criado por um venue específico (null = criador independente)

  duration       Int? // Duração total em semanas
  difficulty     Int? // 1-5 (dificuldade)
  tags           String[] @default([])
  isTemplate     Boolean  @default(false) // Plano reutilizável
  isPublic       Boolean  @default(false) // Visível para todos
  isPremium      Boolean  @default(false) // Requer conta PRO para aceder
  category       String? // "Strength", "CrossFit", "Running", "Hybrid", etc.
  targetAudience String? // "Iniciantes", "Intermédio", "Avançado"

  // Metadata de marketing
  goals        String[] @default([]) // ["Perder peso", "Ganhar força", "Melhorar resistência"]
  requirements String[] @default([]) // ["Barra de pull-ups", "Kettlebell", "Corda"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User   @relation("CreatedPlans", fields: [createdById], references: [id])
  venue     Venue? @relation(fields: [venueId], references: [id])

  weeks              TrainingPlanWeek[]
  assignedToUsers    UserTrainingPlan[]
  assignedToSessions VenueSessionPlan[]
  savedBy            SavedTrainingPlan[]
  translations       TrainingPlanTranslation[]

  @@index([createdById])
  @@index([venueId])
  @@index([isPublic])
  @@index([category])
}

// Traduções para planos de treino
model TrainingPlanTranslation {
  id              String   @id @default(cuid())
  planId          String
  language        Language // en, pt, es, fr, de, it
  name            String // "CrossFit Beginners - 8 Weeks"
  description     String?  @db.Text // Descrição completa do plano
  metaTitle       String? // SEO meta title
  metaDescription String?  @db.Text // SEO meta description

  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, language])
  @@index([planId])
}

// Semana dentro de um plano de treino
// Exemplo: "Semana 1 - Fundamentos", "Semana 2 - Volume", etc.
model TrainingPlanWeek {
  id          String  @id @default(cuid())
  planId      String
  weekNumber  Int // 1, 2, 3, 4...
  name        String? // "Fundamentos", "Teste de Volume", "Deload Week"
  description String? // Foco da semana
  orderIndex  Int // Para reordenar semanas se necessário

  plan     TrainingPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  workouts TrainingPlanWorkout[]

  @@unique([planId, weekNumber])
  @@index([planId])
}

// Workout dentro de uma semana do plano
// Define qual workout fazer em que dia da semana
model TrainingPlanWorkout {
  id         String  @id @default(cuid())
  weekId     String
  workoutId  String
  dayOfWeek  Int // 0=Domingo, 1=Segunda, 2=Terça, ..., 6=Sábado
  orderIndex Int // Ordem dentro do mesmo dia (se houver múltiplos workouts por dia)
  notes      String? // Notas específicas para este workout nesta semana

  week    TrainingPlanWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  workout Workout          @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([weekId])
  @@index([workoutId])
}

// Atribuição de plano de treino a um utilizador
// Tracking de progressão do utilizador através do plano
model UserTrainingPlan {
  id           String             @id @default(cuid())
  userId       String
  planId       String
  assignedById String? // Coach que atribuiu (null se auto-atribuído)
  startDate    DateTime // Data de início do plano
  endDate      DateTime? // Data prevista de fim (calculada pela duração)
  currentWeek  Int                @default(1) // Semana atual do utilizador no plano
  status       TrainingPlanStatus @default(ACTIVE)
  notes        String? // Notas do coach ou do utilizador

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User         @relation("AssignedPlans", fields: [userId], references: [id], onDelete: Cascade)
  plan       TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  assignedBy User?        @relation("PlanAssigner", fields: [assignedById], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([status])
}

// ============================================================================
// SAVED WORKOUTS & TRAINING PLANS (Bookmarks)
// ============================================================================

// Permite ao utilizador guardar/bookmark workouts públicos de outros criadores
model SavedWorkout {
  id        String   @id @default(cuid())
  userId    String
  workoutId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([userId, workoutId])
  @@index([userId])
  @@index([workoutId])
}

// Permite ao utilizador guardar/bookmark planos de treino públicos de outros criadores
model SavedTrainingPlan {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
  @@index([userId])
  @@index([planId])
}

// Atribuição de plano de treino a uma sessão de venue
// Permite que um venue siga um plano estruturado nas suas sessões
model VenueSessionPlan {
  id          String   @id @default(cuid())
  venueId     String
  sessionId   String
  planId      String
  startDate   DateTime // Quando começou a seguir o plano nesta sessão
  currentWeek Int      @default(1)
  notes       String?

  venue   Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  session VenueSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  plan    TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([sessionId, planId])
  @@index([venueId])
  @@index([sessionId])
  @@index([planId])
}

// ============================================================================
// ENUMS para Workout Builder
// ============================================================================

enum WorkoutBlockType {
  WARMUP // Aquecimento
  STRENGTH // Força (sets x reps)
  AMRAP // As Many Rounds As Possible
  EMOM // Every Minute On the Minute
  FOR_TIME // O mais rápido possível
  TABATA // 20s trabalho / 10s descanso
  CHIPPER // Lista de exercícios sequencial
  REST // Descanso
  COOLDOWN // Retorno à calma
  SKILL // Técnica/Skill work
}

enum PostType {
  STANDARD // Regular text/media post
  WOD // Workout of the Day post
  EVENT // Event-related post
  ACHIEVEMENT // Achievement/PR post
}

enum TrainingPlanStatus {
  ACTIVE // A seguir ativamente
  PAUSED // Pausado temporariamente
  COMPLETED // Concluído
  CANCELLED // Cancelado antes de terminar
}

enum WeightUnit {
  KG
  LB
}

enum DistanceUnit {
  M
  KM
  MI
  FT
}

// ─── Analysis Records ─────────────────────────────────────────────────────────

/// Saved motion (pose) analysis — video in B2, JSON data in DB
model MotionAnalysisRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Local UUID generated on the device (for deduplication / idempotency)
  localId String @unique

  label String?

  /// Public B2 URL of the original video clip
  videoUrl String

  /// B2 internal file name (for deletion)
  videoB2Key String

  /// JSON blob: segment, sampleFps, poseFrames[], metrics, videoMeta
  analysisJson Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([localId])
}

/// Saved lift (bar path) analysis — video in B2, JSON data in DB
model LiftAnalysisRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Local UUID generated on the device (for deduplication / idempotency)
  localId String @unique

  label String?

  /// Public B2 URL of the original video clip
  videoUrl String

  /// B2 internal file name (for deletion)
  videoB2Key String

  /// JSON blob: durationMs, fpsSample, seedPoint, barPath[], metrics
  analysisJson Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([localId])
}

/// Tracks AI analysis usage per user — max 10 per 24 hours
model AiAnalysisUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "motion" or "lift"
  type String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ============================================================================
// GIVEAWAYS / SORTEIOS
// ============================================================================

model Giveaway {
  id                     String         @id @default(cuid())
  eventId                String
  status                 GiveawayStatus @default(DRAFT)
  drawAt                 DateTime?
  drawnAt                DateTime?
  prizeCount             Int            @default(1)
  maxWinnersPerUser      Int            @default(1)
  secret                 String? // Private: random secret used in draw algorithm (stored until draw)
  secretHash             String? // Public: SHA-256 hash of secret (published before draw for transparency)
  secretRevealed         String? // Public: revealed secret after draw (proves fairness)
  finalParticipantsCount Int?
  winningTicketNumbers   Int[] // All winning ticket numbers (one per prize)
  winningTicketAttempts  Int[] // Attempt index used per winner (for collision-free verification)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  event          Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  translations   GiveawayTranslation[]
  participations GiveawayParticipation[]
  winners        GiveawayWinner[]

  @@index([eventId])
  @@index([status])
  @@index([drawAt])
}

model GiveawayTranslation {
  id         String   @id @default(cuid())
  giveawayId String
  lang       Language
  title      String
  details    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, lang])
  @@index([giveawayId])
}

model GiveawayParticipation {
  id           String   @id @default(cuid())
  giveawayId   String
  userId       String
  ticketNumber Int
  createdAt    DateTime @default(now())

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId])
  @@unique([giveawayId, ticketNumber])
  @@index([giveawayId])
  @@index([giveawayId, ticketNumber])
  @@index([userId])
}

model GiveawayWinner {
  id         String   @id @default(cuid())
  giveawayId String
  userId     String
  rank       Int
  createdAt  DateTime @default(now())

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId])
  @@index([giveawayId])
  @@index([userId])
}

enum GiveawayStatus {
  DRAFT
  SCHEDULED
  DRAWING
  DRAWN
  CANCELLED
}

// ============================================================================
// ATHLI AI ASSISTANT
// ============================================================================

model AthliConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String? // Auto-generated from first message
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AthliMessage[]

  @@index([userId])
  @@index([createdAt])
}

model AthliMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           AthliMessageRole // user, assistant, system
  content        String           @db.Text
  metadata       Json? // Store tool calls, actions taken (e.g., plan created)
  createdAt      DateTime         @default(now())

  conversation AthliConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

enum AthliMessageRole {
  user
  assistant
  system
}

// ============================================================================
// PLATFORM KNOWLEDGE BASE (for Athli AI to answer questions about Athlifyr)
// ============================================================================

// GPS-tracked run activity (from mobile Free Run feature)
model RunActivity {
  id     String @id @default(cuid())
  userId String

  startedAt      DateTime
  finishedAt     DateTime
  durationMs     Int
  distanceM      Int       // total distance in meters
  avgPaceMinKm   Float?    // avg pace in min/km
  maxSpeedKmh    Float?
  elevationGainM Int       @default(0)
  elevationLossM Int       @default(0)

  // GPS track stored as JSON array of {lat, lng, timestamp, altitude?, speed?, accuracy?}
  track Json @db.JsonB

  // Metadata (Strava-style save screen)
  title           String?
  description     String?
  perceivedEffort Int?     // 1-5 scale
  photos          Json?    @db.JsonB // array of photo URLs
  visibility      String   @default("everyone") // "everyone" | "only_me"
  muted           Boolean  @default(false)

  createdAt DateTime @default(now())

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  performanceEntry UserPerformanceEntry?

  @@index([userId, startedAt])
}

model PlatformKnowledge {
  id        String   @id @default(cuid())
  category  String // e.g. "pricing", "features_venues", "features_athletes", "about", "faq"
  slug      String   @unique // unique identifier e.g. "venue-pricing", "athlete-features"
  title     String // human-readable title
  content   String   @db.Text // markdown content with detailed info
  language  Language @default(pt) // language of the content
  priority  Int      @default(0) // higher = more important, shown first
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([language])
  @@index([isActive])
}
