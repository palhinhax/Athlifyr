# Database
# PostgreSQL connection string for Prisma
# For Neon, use the pooled connection string (ends with ?pgbouncer=true)
DATABASE_URL="postgresql://postgres:password@localhost:5432/athlifyr?pgbouncer=true"
# For Neon, use the direct connection string (for migrations)
DIRECT_URL="postgresql://postgres:password@localhost:5432/athlifyr"

# Application Environment
# Options: development, production, test
NODE_ENV="development"

# Maintenance Mode
# Set to "true" to enable maintenance mode (shows maintenance page to all users)
# Set to "false" or remove to disable maintenance mode
MAINTENANCE_MODE="false"

# Application URL
# Used for SEO, sitemaps, and robots.txt
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
# IMPORTANT: Use canonical domain WITH www for production
# This prevents "invalid_grant" errors from Google OAuth
NEXTAUTH_URL="http://localhost:3000"  # Dev: http://localhost:3000 | Prod: https://www.athlifyr.com

# Google OAuth
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Required scopes: email, profile
# CRITICAL: Callback URL MUST match NEXTAUTH_URL
# Dev: http://localhost:3000/api/auth/callback/google
# Prod: https://www.athlifyr.com/api/auth/callback/google (WITH www!)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google OAuth — Mobile App (used by /api/auth/google/exchange)
# These are SEPARATE OAuth credentials from the web NextAuth ones above.
# Web client ID used by Expo Go / web builds (must match EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in mobile/.env)
GOOGLE_MOBILE_WEB_CLIENT_ID="your-mobile-web-client-id"
GOOGLE_MOBILE_WEB_CLIENT_SECRET="your-mobile-web-client-secret"
# Native client IDs (used for PKCE exchange + audience validation)
GOOGLE_ANDROID_CLIENT_ID="your-android-client-id"
GOOGLE_IOS_CLIENT_ID="your-ios-client-id"

# Apple Sign In — Web (NextAuth)
# Get credentials from: https://developer.apple.com/account/resources/identifiers
# Services ID identifier (e.g., com.athlifyr.app.web)
# CRITICAL: Callback URL MUST match NEXTAUTH_URL (WITH www!)
# Prod: https://www.athlifyr.com/api/auth/callback/apple
APPLE_CLIENT_ID="your-apple-services-id"
# JWT signed with your .p8 private key (expires every 6 months max)
APPLE_CLIENT_SECRET="your-apple-client-secret-jwt"

# Apple Sign In — Mobile (used by /api/auth/apple-mobile)
# Bundle ID of the iOS app (used as audience for token verification)
APPLE_BUNDLE_ID="com.athlifyr.app"

# Google OAuth Authentication Method
# Options: "nextauth" (default) or "rest-api"
# - nextauth: Uses NextAuth.js for automatic session management (recommended)
# - rest-api: Uses direct REST API endpoint (/api/auth/google-web) with JWT tokens
# Only change this if you're experiencing issues with NextAuth Google login
NEXT_PUBLIC_GOOGLE_AUTH_METHOD="nextauth"

# Google Analytics
# Get your Measurement ID from: https://analytics.google.com
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Resend
# Get your API key from: https://resend.com/api-keys
# Used for sending transactional emails (password reset, etc.)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# OpenWeatherMap API
# Get your free API key at: https://openweathermap.org/api
# Free tier: ~1,000 calls/day, 60 requests/minute
OPENWEATHER_API_KEY="your_openweathermap_api_key_here"

# Weather Update Security Token
# Generate a secure random string for the weather update endpoint
# This token is used by GitHub Actions to securely call the weather update API
# Example: openssl rand -hex 32
WEATHER_UPDATE_SECRET="your_secure_random_token_here"

# Web Push Notifications (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
# Public key is sent to browsers, private key stays on server
# Subject should be a mailto: or https: URL
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BAr4eyrVOovwOHHYgfZ-OT-5zzo9lMAYx-PoOpkUte2WyHEecOesDzqDbqEtX_-rRNoHHsVPduDN3JvvvgJX_YQ"
VAPID_PRIVATE_KEY="bVmDDwy3BaJnqjoqIZSNFCmVQ28OrcU36s402vn_a0k"
VAPID_SUBJECT="mailto:hello@athlifyr.com"

# Google Play Integrity API
# Used to verify that API requests come from a genuine Android app
# Package name must match your Android app's package name in app.json
GOOGLE_PLAY_PACKAGE_NAME="com.athlifyr.app"

# Google Service Account credentials JSON (for Play Integrity token decoding)
# Create a service account at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Grant it the "Service Account Token Creator" role
# Export the key as JSON and paste the entire JSON string here (single line)
GOOGLE_APPLICATION_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ─── Live Server (Fastify + Socket.io) ──────────────────────────────────────
# Public URL of the live server for the browser to connect via Socket.io.
# In development: http://localhost:4000
# In production: https://live.athlifyr.com (or wherever the live server is deployed)
NEXT_PUBLIC_LIVE_URL="http://localhost:4000"

# Shared secret between Next.js and the Live Server for internal API calls.
# Generate with: openssl rand -base64 32
LIVE_INTERNAL_SECRET=""

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for API CORS headers.
# In development this can be "*". In production use your actual domains.
# Example: "https://www.athlifyr.com,https://athlifyr.com"
ALLOWED_ORIGINS="*"

# ─── Cron / Scheduled Tasks ─────────────────────────────────────────────────
# Secret used to authenticate cron requests (e.g., Vercel Cron).
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# ─── Giveaway Draw ──────────────────────────────────────────────────────────
# Secret used to authenticate the giveaway draw endpoint (GitHub Actions).
# Generate with: openssl rand -base64 32
GIVEAWAY_DRAW_SECRET=""

# Athli AI Assistant (OpenAI)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# ─── Scraping Service ────────────────────────────────────────────────────────
# Internal URL of the Python FastAPI scraping service (server-side only, NOT public)
# In development: http://localhost:8000/api/v1
# In production: your Railway internal/public URL + /api/v1
SCRAPING_API_URL="http://localhost:8000/api/v1"

# Shared API key between Next.js and the Python scraping service
# Must be identical on both sides. Generate with: openssl rand -base64 32
# On the Python side, set as SCRAPING_API_KEY in Railway env vars
SCRAPING_API_KEY=""

