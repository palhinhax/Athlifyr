{
  "info": {
    "_postman_id": "athlifyr-api-v2",
    "name": "Athlifyr Video Analysis API v2.3",
    "description": "API para análise de vídeos de fitness com tracking de barra, pose estimation e análise AI.\n\nv2.3 — seed_x/seed_y normalizados (0–1), result_upload_url para PUT do vídeo processado para B2.\nv2.2 — Novos endpoints URL-based (/analyze/full/url e /analyze/body/url) para fluxo Backblaze B2.\nv2.1 — Adicionados parâmetros enable_ai e language para análise inteligente com OpenAI GPT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    {
      "key": "railway_url",
      "value": "https://barbell-path-tracker-production.up.railway.app",
      "type": "string"
    },
    {
      "key": "b2_bucket_url",
      "value": "https://f003.backblazeb2.com",
      "type": "string"
    },
    {
      "key": "b2_bucket_name",
      "value": "athlifyr",
      "type": "string"
    },
    {
      "key": "test_video_url",
      "value": "https://s3.us-east-005.backblazeb2.com/athlifyr/uploads/test/sample.mp4",
      "type": "string",
      "description": "Replace with a real presigned B2 download URL for testing"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health - Local",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Health - Railway",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{railway_url}}/health",
              "host": ["{{railway_url}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Analyze Full",
      "description": "Análise completa com tracking de barra + pose de perfil.\nParâmetros enable_ai e language controlam a análise AI (desligada por default).",
      "item": [
        {
          "name": "Analyze Full - Railway",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "video",
                  "type": "file",
                  "src": "",
                  "description": "Vídeo de perfil (.mp4, .mov, .avi)"
                },
                {
                  "key": "seed_x",
                  "value": "50",
                  "type": "text",
                  "description": "Posição X do peso em % (0-100)"
                },
                {
                  "key": "seed_y",
                  "value": "60",
                  "type": "text",
                  "description": "Posição Y do peso em % (0-100)"
                },
                {
                  "key": "seed_frame",
                  "value": "0",
                  "type": "text",
                  "description": "Frame onde o ponto foi selecionado"
                },
                {
                  "key": "show_angles",
                  "value": "true",
                  "type": "text",
                  "description": "Mostrar ângulos no vídeo"
                },
                {
                  "key": "auto_detect",
                  "value": "true",
                  "type": "text",
                  "description": "Auto-detectar centro do disco"
                },
                {
                  "key": "enable_ai",
                  "value": "false",
                  "type": "text",
                  "description": "🆕 Activar análise AI (default: false)"
                },
                {
                  "key": "language",
                  "value": "pt",
                  "type": "text",
                  "description": "🆕 Língua da resposta AI: pt, en, es, fr, de, it"
                }
              ]
            },
            "url": {
              "raw": "{{railway_url}}/analyze/full",
              "host": ["{{railway_url}}"],
              "path": ["analyze", "full"]
            },
            "description": "Análise completa sem AI (comportamento padrão)."
          }
        },
        {
          "name": "Analyze Full + AI (PT) - Railway",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "video",
                  "type": "file",
                  "src": "",
                  "description": "Vídeo de perfil (.mp4, .mov, .avi)"
                },
                {
                  "key": "seed_x",
                  "value": "50",
                  "type": "text",
                  "description": "Posição X do peso em % (0-100)"
                },
                {
                  "key": "seed_y",
                  "value": "60",
                  "type": "text",
                  "description": "Posição Y do peso em % (0-100)"
                },
                { "key": "seed_frame", "value": "0", "type": "text" },
                { "key": "show_angles", "value": "true", "type": "text" },
                { "key": "auto_detect", "value": "true", "type": "text" },
                {
                  "key": "enable_ai",
                  "value": "true",
                  "type": "text",
                  "description": "AI activada"
                },
                {
                  "key": "language",
                  "value": "pt",
                  "type": "text",
                  "description": "Resposta em Português"
                }
              ]
            },
            "url": {
              "raw": "{{railway_url}}/analyze/full",
              "host": ["{{railway_url}}"],
              "path": ["analyze", "full"]
            },
            "description": "Análise completa COM AI em Português. O campo ai_analysis terá exercício, reps, score e coaching."
          }
        },
        {
          "name": "Analyze Full + AI (EN) - Railway",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "video",
                  "type": "file",
                  "src": "",
                  "description": "Vídeo de perfil (.mp4, .mov, .avi)"
                },
                {
                  "key": "seed_x",
                  "value": "50",
                  "type": "text",
                  "description": "Posição X do peso em % (0-100)"
                },
                {
                  "key": "seed_y",
                  "value": "60",
                  "type": "text",
                  "description": "Posição Y do peso em % (0-100)"
                },
                { "key": "seed_frame", "value": "0", "type": "text" },
                { "key": "show_angles", "value": "true", "type": "text" },
                { "key": "auto_detect", "value": "true", "type": "text" },
                {
                  "key": "enable_ai",
                  "value": "true",
                  "type": "text",
                  "description": "AI activada"
                },
                {
                  "key": "language",
                  "value": "en",
                  "type": "text",
                  "description": "Resposta em English"
                }
              ]
            },
            "url": {
              "raw": "{{railway_url}}/analyze/full",
              "host": ["{{railway_url}}"],
              "path": ["analyze", "full"]
            },
            "description": "Análise completa COM AI em Inglês."
          }
        }
      ]
    },
    {
      "name": "Analyze Body",
