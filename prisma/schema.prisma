generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(cuid())
  name                     String?
  email                    String                    @unique
  emailVerified            DateTime?
  image                    String?
  password                 String?
  role                     UserRole                  @default(USER)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  favoriteSports           SportType[]
  locale                   String                    @default("pt")
  isBanned                 Boolean                   @default(false)
  emailNotifications       Boolean                   @default(false)
  isProAccount             Boolean                   @default(false)
  accounts                 Account[]
  comments                 Comment[]
  eventsPreferences        EventsPreferences?
  receivedFriendships      Friendship[]              @relation("FriendshipReceiver")
  sentFriendships          Friendship[]              @relation("FriendshipSender")
  instagramDrafts          InstagramPostDraft[]
  mapPreferences           MapPreferences?
  participations           Participation[]
  paymentIntents           PaymentIntent[]
  posts                    Post[]
  postComments             PostComment[]
  postLikes                PostLike[]
  photos                   ProfilePhoto[]
  results                  Result[]
  sessions                 Session[]
  venueBookings            VenueBooking[]
  venueMembers             VenueMember[]
  venueOwnershipClaims     VenueOwnershipClaim[]
  venueRecommendations     VenueRecommendation[]
  venueReviews             VenueReview[]
  venueReviewReplies       VenueReviewReply[]
  venueSubscriptions       VenueSubscription[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  reportsMade              UserReport[]              @relation("ReportsMade")
  reportsReceived          UserReport[]              @relation("ReportsReceived")
  blocksMade               UserBlock[]               @relation("BlocksMade")
  blocksReceived           UserBlock[]               @relation("BlocksReceived")
  performanceEntries       UserPerformanceEntry[]
  exercises                Exercise[]

  // Workout Builder relations
  createdWorkouts  Workout[]     @relation("CreatedWorkouts")
  assignedWorkouts UserWorkout[] @relation("AssignedWorkouts")
  workoutsAssigned UserWorkout[] @relation("WorkoutAssigner")
  workoutLogs      WorkoutLog[]
  savedWorkouts    SavedWorkout[]

  // Training Plans relations
  createdPlans          TrainingPlan[]          @relation("CreatedPlans")
  assignedPlans         UserTrainingPlan[]      @relation("AssignedPlans")
  plansAssigned         UserTrainingPlan[]      @relation("PlanAssigner")
  savedTrainingPlans    SavedTrainingPlan[]

  @@index([email])
  @@index([name])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model Event {
  id                   String             @id @default(cuid())
  title                String
  slug                 String             @unique
  description          String
  startDate            DateTime
  endDate              DateTime?
  city                 String
  country              String             @default("Portugal")
  imageUrl             String?
  externalUrl          String?
  isFeatured           Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  sportTypes           SportType[]
  registrationDeadline DateTime?
  googleMapsUrl        String?
  latitude             Float?
  longitude            Float?
  stravaRouteEmbed     String?
  featuredVenueId      String?
  featuredVenue        Venue?             @relation("FeaturedVenue", fields: [featuredVenueId], references: [id], onDelete: SetNull)
  comments             Comment[]
  faqs                 EventFAQ[]
  translations         EventTranslation[]
  variants             EventVariant[]
  weather              EventWeather[]
  participations       Participation[]
  posts                Post[]
  pricingPhases        PricingPhase[]
  results              Result[]

  @@index([sportTypes])
  @@index([startDate])
  @@index([city])
  @@index([isFeatured])
  @@index([slug])
  @@index([featuredVenueId])
}

model EventTranslation {
  id              String   @id @default(cuid())
  eventId         String
  language        Language
  title           String
  description     String
  city            String?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, language])
  @@index([eventId])
  @@index([language])
  @@index([title])
}

model EventFAQ {
  id           String                @id @default(cuid())
  eventId      String
  order        Int                   @default(0)
  question     String
  answer       String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  translations EventFAQTranslation[]

  @@index([eventId])
  @@index([order])
}

model EventFAQTranslation {
  id        String   @id @default(cuid())
  faqId     String
  language  Language
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  faq       EventFAQ @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([faqId, language])
  @@index([faqId])
  @@index([language])
}

model EventVariant {
  id                String                    @id @default(cuid())
  eventId           String
  name              String
  price             Float?
  maxParticipants   Int?
  description       String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  distanceKm        Float?
  startDate         DateTime?
  startTime         String?
  atrpGrade         Int?
  cutoffTimeHours   Float?
  elevationGainM    Int?
  elevationLossM    Int?
  itraPoints        Int?
  mountainLevel     Int?
  currency          Currency                  @default(EUR)
  event             Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  translations      EventVariantTranslation[]
  participations    Participation[]
  pricingPhases     PricingPhase[]
  results           Result[]
  triathlonSegments TriathlonSegment[]

  @@index([eventId])
  @@index([startDate])
}

model EventVariantTranslation {
  id          String       @id @default(cuid())
  variantId   String
  language    Language
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  variant     EventVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, language])
  @@index([variantId])
  @@index([language])
}

model TriathlonSegment {
  id          String               @id @default(cuid())
  variantId   String
  segmentType TriathlonSegmentType
  distanceKm  Float
  terrainType TriathlonTerrainType
  order       Int
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  variant     EventVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([order])
}

model PricingPhase {
  id              String        @id @default(cuid())
  eventId         String?
  variantId       String?
  name            String
  startDate       DateTime
  endDate         DateTime
  price           Float
  discountPercent Int?
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  currency        Currency      @default(EUR)
  event           Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  variant         EventVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([variantId])
  @@index([startDate])
}

model Participation {
  id             String        @id @default(cuid())
  userId         String
  eventId        String
  variantId      String?
  status         String        @default("going")
  completionTime Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant        EventVariant? @relation(fields: [variantId], references: [id])

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model Result {
  id               String   @id @default(cuid())
  userId           String
  eventId          String
  variantId        String?
  time             String // Format: "HH:MM:SS" or "MM:SS"
  timeSeconds      Int? // Total time in seconds for calculations
  position         Int? // Overall position
  categoryPosition Int? // Position in category/age group
  notes            String?
  isPublic         Boolean  @default(true) // Show on public profile
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  event            Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant          EventVariant?         @relation(fields: [variantId], references: [id])
  performanceEntry UserPerformanceEntry? @relation("ResultPerformance")

  @@unique([userId, eventId, variantId]) // One result per user per variant
  @@index([userId])
  @@index([eventId])
  @@index([userId, createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  userId    String
  eventId   String
  parentId  String?
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([parentId])
}

model Post {
  id         String        @id @default(cuid())
  userId     String
  eventId    String?
  content    String
  imageUrl   String?
  mediaType  String?       @default("image") // "image" or "video"
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  isAutoPost Boolean       @default(false)
  venueId    String?
  isPublic   Boolean       @default(false)
  event      Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue      Venue?        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  comments   PostComment[]
  likes      PostLike[]

  @@index([userId])
  @@index([eventId])
  @@index([venueId])
  @@index([createdAt])
  @@index([isPublic])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model ProfilePhoto {
  id        String   @id @default(cuid())
  userId    String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Friendship {
  id         String           @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  receiver   User             @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User             @relation("FriendshipSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model InstagramPostDraft {
  id          String          @id @default(cuid())
  userId      String
  templateKey String
  format      InstagramFormat @default(SQUARE)
  payload     Json
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  type      String   @default("other")
  subject   String
  message   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model MapPreferences {
  id             String      @id @default(cuid())
  userId         String      @unique
  sports         SportType[]
  distanceRadius Int?
  dateRange      String?
  centerLat      Float?
  centerLng      Float?
  zoom           Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AnonymousMapPreferences {
  id             String      @id @default(cuid())
  anonymousId    String      @unique
  sports         SportType[]
  distanceRadius Int?
  dateRange      String?
  centerLat      Float?
  centerLng      Float?
  zoom           Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  lastAccessedAt DateTime    @default(now())

  @@index([anonymousId])
  @@index([lastAccessedAt])
}

model EventsPreferences {
  id              String      @id @default(cuid())
  userId          String      @unique
  sports          SportType[]
  distanceRadius  Int?
  dateRange       String?
  searchQuery     String?
  userLat         Float?
  userLng         Float?
  locationEnabled Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AnonymousEventsPreferences {
  id              String      @id @default(cuid())
  anonymousId     String      @unique
  sports          SportType[]
  distanceRadius  Int?
  dateRange       String?
  searchQuery     String?
  userLat         Float?
  userLng         Float?
  locationEnabled Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lastAccessedAt  DateTime    @default(now())

  @@index([anonymousId])
  @@index([lastAccessedAt])
}

model Venue {
  id                                 String                  @id @default(cuid())
  slug                               String                  @unique
  name                               String
  type                               VenueType
  sportTypes                         SportType[]
  services                           VenueService[]          @default([])
  description                        String?
  phone                              String?
  email                              String?
  website                            String?
  instagram                          String?
  whatsapp                           String?
  address                            String?
  city                               String?
  country                            String                  @default("Portugal")
  latitude                           Float?
  longitude                          Float?
  paymentMode                        PaymentMode             @default(MIXED)
  externalPaymentInstructions        String?
  createdByUserId                    String
  isVerified                         Boolean                 @default(false)
  isActive                           Boolean                 @default(true)
  createdAt                          DateTime                @default(now())
  updatedAt                          DateTime                @updatedAt
  coverImage                         String?
  logo                               String?
  defaultBookingAdvanceDays          Int                     @default(4)
  defaultCancellationDeadlineMinutes Int                     @default(30)
  defaultSessionCapacity             Int?
  commissionType                     CommissionType          @default(PERCENT)
  commissionValue                    Int                     @default(1000)
  paymentsProvider                   PaymentsProvider        @default(NONE)
  stripeAccountId                    String?                 @unique
  stripeChargesEnabled               Boolean                 @default(false)
  stripeDetailsSubmitted             Boolean                 @default(false)
  stripeLastWebhookAt                DateTime?
  stripeOnboardingStatus             StripeOnboardingStatus  @default(NOT_STARTED)
  stripePayoutsEnabled               Boolean                 @default(false)
  visibleTabs                        String[]                @default(["feed", "about", "plans", "sessions", "team", "clients", "subscriptions"])
  paymentIntents                     PaymentIntent[]
  posts                              Post[]
  bookings                           VenueBooking[]
  invites                            VenueInvite[]
  members                            VenueMember[]
  ownershipClaims                    VenueOwnershipClaim[]
  plans                              VenuePlan[]
  recommendations                    VenueRecommendation[]
  recurringSessions                  VenueRecurringSession[]
  reviews                            VenueReview[]
  sessions                           VenueSession[]
  subscriptions                      VenueSubscription[]
  images                             VenueImage[]
  featuredInEvents                   Event[]                 @relation("FeaturedVenue")

  translations VenueTranslation[]

  // Workout Builder relations
  workouts      Workout[]
  trainingPlans TrainingPlan[]
  sessionPlans  VenueSessionPlan[]

  @@index([slug])
  @@index([type])
  @@index([city])
  @@index([isActive])
  @@index([createdByUserId])
  @@index([sportTypes])
}

model VenueImage {
  id        String   @id @default(cuid())
  venueId   String
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([order])
  @@index([createdAt])
}

model VenueTranslation {
  id              String   @id @default(cuid())
  venueId         String
  language        Language
  description     String?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  venue           Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, language])
  @@index([venueId])
  @@index([language])
}

model VenueMember {
  id        String       @id @default(cuid())
  venueId   String
  userId    String
  role      VenueRole
  status    MemberStatus @default(PENDING)
  joinedAt  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
  @@index([venueId])
  @@index([userId])
  @@index([status])
}

model VenueOwnershipClaim {
  id         String                    @id @default(cuid())
  venueId    String
  userId     String
  status     VenueOwnershipClaimStatus @default(PENDING)
  message    String? // Optional message from user explaining their claim
  adminNotes String? // Notes from admin when reviewing
  reviewedAt DateTime?
  reviewedBy String? // Admin who reviewed
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue      Venue                     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
  @@index([venueId])
  @@index([userId])
  @@index([status])
}

model VenueInvite {
  id              String       @id @default(cuid())
  venueId         String
  invitedUserId   String?
  invitedEmail    String?
  invitedByUserId String
  role            VenueRole
  token           String       @unique
  status          InviteStatus @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  venue           Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([invitedUserId])
  @@index([invitedEmail])
  @@index([token])
  @@index([status])
}

model VenuePlan {
  id             String              @id @default(cuid())
  venueId        String
  name           String
  description    String?
  price          Float?
  currency       Currency            @default(EUR)
  // paymentProvider removed - now managed at venue level via Venue.paymentMode
  isActive       Boolean             @default(true)
  policy         Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  paymentIntents PaymentIntent[]
  venue          Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  subscriptions  VenueSubscription[]

  @@index([venueId])
  @@index([isActive])
}

model VenueSubscription {
  id                 String        @id @default(cuid())
  venueId            String
  userId             String
  planId             String
  status             String        @default("PENDING")
  paymentStatus      PaymentStatus @default(PENDING_PAYMENT)
  activatedByUserId  String?
  activatedAt        DateTime?
  paymentMethod      String?
  paymentAmount      Float?
  paymentNote        String?
  paymentConfirmedAt DateTime?
  startsAt           DateTime      @default(now())
  endsAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  plan               VenuePlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue              Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([paymentStatus])
}

model VenueRecurringSession {
  id                          String         @id @default(cuid())
  venueId                     String
  type                        SessionType
  title                       String
  description                 String?
  dayOfWeek                   Int
  startTime                   String
  endTime                     String
  capacity                    Int?
  coachId                     String?
  serviceId                   String?
  tags                        String[]
  isActive                    Boolean        @default(true)
  generatedUntil              DateTime?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  bookingAdvanceDays          Int            @default(4)
  cancellationDeadlineMinutes Int            @default(30)
  venue                       Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sessions                    VenueSession[]

  @@index([venueId])
  @@index([dayOfWeek])
  @@index([isActive])
}

model VenueSession {
  id                          String                 @id @default(cuid())
  venueId                     String
  type                        SessionType
  title                       String
  description                 String?
  startsAt                    DateTime
  endsAt                      DateTime
  capacity                    Int?
  coachId                     String?
  serviceId                   String?
  tags                        String[]
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  recurringSessionId          String?
  bookingAdvanceDays          Int                    @default(4)
  cancellationDeadlineMinutes Int                    @default(30)
  bookings                    VenueBooking[]
  recurringSession            VenueRecurringSession? @relation(fields: [recurringSessionId], references: [id])
  venue                       Venue                  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Workout Builder relations
  sessionWorkouts VenueSessionWorkout[]
  workoutLogs     WorkoutLog[]
  sessionPlans    VenueSessionPlan[]

  @@index([venueId])
  @@index([type])
  @@index([startsAt])
  @@index([coachId])
  @@index([recurringSessionId])
}

model VenueBooking {
  id         String        @id @default(cuid())
  venueId    String
  sessionId  String
  userId     String?
  status     BookingStatus @default(BOOKED)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  guestEmail String?
  guestName  String?
  session    VenueSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue      Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([sessionId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model PaymentIntent {
  id                    String              @id @default(cuid())
  venueId               String
  userId                String
  planId                String
  amount                Float
  currency              Currency            @default(EUR)
  status                PaymentIntentStatus @default(CREATED)
  provider              String              @default("INTERNAL_MVP")
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  confirmedAt           DateTime?
  stripePaymentIntentId String?             @unique
  plan                  VenuePlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
