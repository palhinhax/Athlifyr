# API Configuration
EXPO_PUBLIC_API_URL=https://www.athlifyr.com
EXPO_PUBLIC_API_TIMEOUT=30000

# Environment
NODE_ENV=development

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
# 1. Create a project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials for Web, Android, and iOS
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id_here.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id_here.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id_here.apps.googleusercontent.com

# Optional: Google Maps API Key (for advanced map features)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_api_key_here

# Mapbox Configuration (Required for events map)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Optional: Analytics
# EXPO_PUBLIC_ANALYTICS_ID=your_analytics_id

# Sentry Error Monitoring
# Create a React Native project at https://sentry.io and paste the DSN here
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Optional: Analytics, etc.
# GOOGLE_ANALYTICS_ID=

# Google Play Integrity API
# Your Google Cloud project number (numeric) for Play Integrity verification
# Find it at: https://console.cloud.google.com/ → Project Settings → Project number
EXPO_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=your_project_number_here
