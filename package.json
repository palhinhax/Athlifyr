{
  "name": "athlifyr",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed:test-users": "npx tsx prisma/seeds/test-users.ts",
    "db:seed:test-user": "npx tsx prisma/seeds/test-user-simple.ts",
    "db:seed:exercises": "npx tsx prisma/seeds/exercises-seed.ts",
    "db:studio": "prisma studio",
    "prepare": "husky",
    "semantic-release": "semantic-release",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:auth": "playwright test tests/e2e/auth-users.spec.ts",
    "test:e2e:functional": "playwright test tests/e2e/functional-tests.spec.ts",
    "test:e2e:admin": "playwright test -g \"Admin\"",
    "test:e2e:owner": "playwright test -g \"Owner\"",
    "test:e2e:coach": "playwright test -g \"Coach\"",
    "test:e2e:member": "playwright test -g \"Atleta|Member\"",
    "test:e2e:free": "playwright test -g \"Free\"",
    "test:e2e:security": "playwright test -g \"Security\"",
    "test:e2e:i18n": "playwright test -g \"Internationalization\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
