generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model User {
  id                       String                    @id @default(cuid())
  name                     String?
  email                    String                    @unique
  emailVerified            DateTime?
  image                    String?
  password                 String?
  role                     UserRole                  @default(USER)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  favoriteSports           SportType[]
  locale                   String                    @default("pt")
  isBanned                 Boolean                   @default(false)
  emailNotifications       Boolean                   @default(false)
  pushNotificationsEnabled Boolean                   @default(true)
  isProAccount             Boolean                   @default(false)
  liveRaceVisibility       LiveRaceVisibility        @default(PUBLIC)
  dateOfBirth              DateTime?
  citizenId                String?
  nationality              String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  accounts                 Account[]
  comments                 Comment[]
  eventsPreferences        EventsPreferences?
  receivedFriendships      Friendship[]              @relation("FriendshipReceiver")
  sentFriendships          Friendship[]              @relation("FriendshipSender")
  instagramDrafts          InstagramPostDraft[]
  mapPreferences           MapPreferences?
  participations           Participation[]
  paymentIntents           PaymentIntent[]
  posts                    Post[]
  postComments             PostComment[]
  postLikes                PostLike[]
  photos                   ProfilePhoto[]
  results                  Result[]
  sessions                 Session[]
  venueBookings            VenueBooking[]
  venueBookingsAddedByMe   VenueBooking[]            @relation("StaffAddedBookings")
  venueMembers             VenueMember[]
  venueOwnershipClaims     VenueOwnershipClaim[]
  venueRecommendations     VenueRecommendation[]
  venueReviews             VenueReview[]
  venueReviewReplies       VenueReviewReply[]
  venueSubscriptions       VenueSubscription[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  reportsMade              UserReport[]              @relation("ReportsMade")
  reportsReceived          UserReport[]              @relation("ReportsReceived")
  blocksMade               UserBlock[]               @relation("BlocksMade")
  blocksReceived           UserBlock[]               @relation("BlocksReceived")
  performanceEntries       UserPerformanceEntry[]
  exercises                Exercise[]

  // Workout Builder relations
  createdWorkouts  Workout[]      @relation("CreatedWorkouts")
  assignedWorkouts UserWorkout[]  @relation("AssignedWorkouts")
  workoutsAssigned UserWorkout[]  @relation("WorkoutAssigner")
  workoutLogs      WorkoutLog[]
  savedWorkouts    SavedWorkout[]

  // Training Plans relations
  createdPlans       TrainingPlan[]      @relation("CreatedPlans")
  assignedPlans      UserTrainingPlan[]  @relation("AssignedPlans")
  plansAssigned      UserTrainingPlan[]  @relation("PlanAssigner")
  savedTrainingPlans SavedTrainingPlan[]

  // Push notification tokens
  pushTokens PushToken[]

  // Notifications
  notifications Notification[]

  // Analysis records (motion & lift)
  motionAnalyses   MotionAnalysisRecord[]
  liftAnalyses     LiftAnalysisRecord[]
  aiAnalysisUsages AiAnalysisUsage[]

  // Giveaway relations
  giveawayParticipations GiveawayParticipation[]
  giveawayWins           GiveawayWinner[]

  // Athli AI assistant
  athliConversations AthliConversation[]

  // Admin notes (event/venue submission requests from chat)
  adminNotes AdminNote[]

  // LiveRace - Event registrations
  registrations Registration[]

  // LiveRace - Event Organizer / Staff / Invites
  eventOrganizer          EventOrganizer[]     @relation("EventOrganizerUser")
  eventOrganizerAdded     EventOrganizer[]     @relation("EventOrganizerAddedBy")
  eventStaffMember        EventStaffMember[]   @relation("EventStaffMemberUser")
  eventStaffMemberAdded   EventStaffMember[]   @relation("EventStaffMemberAddedBy")
  eventInvitesSent        EventInvite[]        @relation("EventInvitedBy")

  // Custom field responses (event registration extras)
  customFieldResponses    CustomFieldResponse[]

  // GPS-tracked run activities (Free Run, etc.)
  runActivities RunActivity[]

  @@index([email])
  @@index([name])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model Event {
  id                   String             @id @default(cuid())
  title                String
  slug                 String             @unique
  description          String
  startDate            DateTime
  endDate              DateTime?
  city                 String
  country              String             @default("Portugal")
  imageUrl             String?
  externalUrl          String?
  isFeatured           Boolean            @default(false)
  cancelled            Boolean            @default(false)
  cancelledAt          DateTime?
  cancellationReason   String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  sportTypes           SportType[]
  registrationDeadline DateTime?
  googleMapsUrl        String?
  latitude             Float?
  longitude            Float?
  stravaRouteEmbed     String?
  featuredVenueId      String?
  featuredVenue        Venue?             @relation("FeaturedVenue", fields: [featuredVenueId], references: [id], onDelete: SetNull)
  comments             Comment[]
  faqs                 EventFAQ[]
  translations         EventTranslation[]
  variants             EventVariant[]
  weather              EventWeather[]
  participations       Participation[]
  posts                Post[]
  pricingPhases        PricingPhase[]
  results              Result[]
  giveaways            Giveaway[]
  registrations        Registration[]
  organizers           EventOrganizer[]
  staffMembers         EventStaffMember[]
  invites              EventInvite[]
  customFields         EventCustomField[]

  // ── Feature flags ──────────────────────────────────────────────────────────
  // hasRegistrations is derived: automatically true when stripeOnboardingStatus = COMPLETE
  hasRegistrations     Boolean                     @default(false)
  // hasLiveRace can only be activated by a Platform Admin
  hasLiveRace          Boolean                     @default(false)

  // ── Stripe Connect (per-event, destination charges) ────────────────────────
  stripeAccountId          String?
  stripeChargesEnabled     Boolean                     @default(false)
  stripeDetailsSubmitted   Boolean                     @default(false)
  stripePayoutsEnabled     Boolean                     @default(false)
  stripeLastWebhookAt      DateTime?
  stripeOnboardingStatus   EventStripeOnboardingStatus @default(NOT_STARTED)
  commissionPercent        Float                       @default(0.0)
  commissionFixed          Int                         @default(0) // cêntimos

  // ── Registration settings ──────────────────────────────────────────────────
  refundDeadline              DateTime?
  checkInOpensAt              DateTime?
  checkInClosesAt             DateTime?
  registrationFieldSettings   Json       @default("{}")  // e.g. { "dateOfBirth": "required", "citizenId": "optional" }

  // ── LiveRace settings ──────────────────────────────────────────────────────
  liveStatus           EventLiveStatus             @default(SCHEDULED)

  @@index([sportTypes])
  @@index([startDate])
  @@index([city])
  @@index([isFeatured])
  @@index([slug])
  @@index([featuredVenueId])
  @@index([hasRegistrations])
  @@index([hasLiveRace])
}

model EventTranslation {
  id              String   @id @default(cuid())
  eventId         String
  language        Language
  title           String
  description     String
  city            String?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, language])
  @@index([eventId])
  @@index([language])
  @@index([title])
}

model EventFAQ {
  id           String                @id @default(cuid())
  eventId      String
  order        Int                   @default(0)
  question     String
  answer       String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  translations EventFAQTranslation[]

  @@index([eventId])
  @@index([order])
}

model EventFAQTranslation {
  id        String   @id @default(cuid())
  faqId     String
  language  Language
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  faq       EventFAQ @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([faqId, language])
  @@index([faqId])
  @@index([language])
}

model EventVariant {
  id                String                    @id @default(cuid())
  eventId           String
  name              String
  price             Float?
  maxParticipants   Int?
  description       String?
  teamSize          Int                       @default(1) // 1 = individual, 2-4 = team (total people including the registrant)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  distanceKm        Float?
  startDate         DateTime?
  startTime         String?
  atrpGrade         Int?
  cutoffTimeHours   Float?
  elevationGainM    Int?
  elevationLossM    Int?
  itraPoints        Int?
  mountainLevel     Int?
  currency          Currency                  @default(EUR)
  event             Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  translations      EventVariantTranslation[]
  participations    Participation[]
  pricingPhases     PricingPhase[]
  results           Result[]
  triathlonSegments TriathlonSegment[]
  registrations     Registration[]
  route             EventRoute?

  @@index([eventId])
  @@index([startDate])
}

/// GPX route for an event variant — one route per variant
model EventRoute {
  id              String             @id @default(cuid())
  variantId       String             @unique
  variant         EventVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Original GPX file content (XML string)
  gpxData         String?            @db.Text
  /// Simplified polyline points [[lat, lng], ...] — used for map rendering
  routePoints     Json               @default("[]")
  /// Distance in km (auto-calculated from GPX or manually set)
  distanceKm      Float?
  /// Total elevation gain in meters (auto-calculated from GPX)
  elevationGainM  Int?
  /// Total elevation loss in meters (auto-calculated from GPX)
  elevationLossM  Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  checkpoints     RouteCheckpoint[]

  @@index([variantId])
}

enum CheckpointType {
  START
  FINISH
  INTERMEDIATE
  TRANSITION   // for triathlon/multi-sport
}

/// A gate/checkpoint that athletes must pass through
model RouteCheckpoint {
  id          String         @id @default(cuid())
  routeId     String
  route       EventRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name        String
  type        CheckpointType @default(INTERMEDIATE)
  /// Order of passage (0 = start, last = finish)
  order       Int
  latitude    Float
  longitude   Float
  /// Optional radius in meters for geofencing detection on mobile
  radiusM     Int            @default(50)
  /// Optional cutoff time from race start in minutes
  cutoffMin   Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([routeId])
  @@index([routeId, order])
}

model EventVariantTranslation {
  id          String       @id @default(cuid())
  variantId   String
  language    Language
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  variant     EventVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, language])
  @@index([variantId])
  @@index([language])
}

model TriathlonSegment {
  id          String               @id @default(cuid())
  variantId   String
  segmentType TriathlonSegmentType
  distanceKm  Float
  terrainType TriathlonTerrainType
  order       Int
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  variant     EventVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([order])
}

model PricingPhase {
  id              String        @id @default(cuid())
  eventId         String?
  variantId       String?
  name            String
  startDate       DateTime
  endDate         DateTime
  price           Float
  discountPercent Int?
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  currency        Currency      @default(EUR)
  event           Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  variant         EventVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([variantId])
  @@index([startDate])
}

model Participation {
  id             String        @id @default(cuid())
  userId         String
  eventId        String
  variantId      String?
  status         String        @default("going")
  completionTime Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant        EventVariant? @relation(fields: [variantId], references: [id])
  customFieldResponses CustomFieldResponse[]

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model Registration {
  id          String             @id @default(cuid())
  userId      String
  eventId     String
  variantId   String
  status      RegistrationStatus @default(PENDING)
  bibNumber   String? // Dorsal (opcional, atribuído pelo organizador)
  checkedInAt DateTime? // Timestamp do check-in
  ticketNonce String    @default(cuid()) // Rotated on ticket revocation; invalidates old JWTs

  // Stripe
  paymentProvider         String   @default("STRIPE")
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  amountCents             Int // Valor pago (cêntimos)
  feeCents                Int? // Taxa de serviço (opcional)
  netCents                Int? // Valor líquido (opcional)
  currency                Currency @default(EUR)

  // ── Team registration ──────────────────────────────────────────────────────
  // All members of a team share the same teamGroupId.
  // The person who paid has teamRole = LEADER; others are MEMBER.
  // For individual registrations both fields are null.
  teamGroupId      String?
  teamRole         TeamRole?
  teamMemberIndex  Int       @default(0) // 0 = leader/individual, 1+ = team members

  // Guest data — populated for team members that are NOT registered users.
  // When the team leader registers, they provide this data for each member.
  guestName                  String?
  guestEmail                 String?
  guestPhone                 String?
  guestDateOfBirth           DateTime?
  guestCitizenId             String?
  guestEmergencyContactName  String?
  guestEmergencyContactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  variant EventVariant @relation(fields: [variantId], references: [id])

  customFieldResponses CustomFieldResponse[]

  @@unique([userId, eventId, variantId, teamMemberIndex])
  @@index([userId])
  @@index([eventId])
  @@index([variantId])
  @@index([status])
  @@index([stripeCheckoutSessionId])
  @@index([teamGroupId])
}

// ============================================================================
// CUSTOM FIELDS (organizer-defined per event)
// ============================================================================

/// A custom field defined by the organizer for an event.
/// Examples: "T-shirt size", "Lunch", "Engraved medal"
model EventCustomField {
  id          String              @id @default(cuid())
  eventId     String
  label       String              // e.g. "T-shirt size"
  type        CustomFieldType     @default(SELECT) // SELECT = pick one, BOOLEAN = yes/no
  options     String[]            // e.g. ["S", "M", "L", "XL"]  (only for SELECT type)
  required    Boolean             @default(false)
  priceCents  Int                 @default(0)      // additional cost in cents (0 = free)
  currency    Currency            @default(EUR)
  order       Int                 @default(0)       // display order
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  responses CustomFieldResponse[]

  @@index([eventId])
  @@index([order])
}

/// A participant's response to one custom field.
/// participantIndex 0 = main registrant, 1 = team member #2, 2 = team member #3, etc.
model CustomFieldResponse {
  id               String           @id @default(cuid())
  customFieldId    String
  registrationId   String?
  participationId  String?
  userId           String
  participantIndex Int              @default(0) // 0 = main, 1+ = team members
  value            String           // e.g. "M", "true", "false"
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  customField    EventCustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  registration   Registration?    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  participation  Participation?   @relation(fields: [participationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, registrationId, participantIndex])
  @@unique([customFieldId, participationId, participantIndex])
  @@index([customFieldId])
  @@index([registrationId])
  @@index([participationId])
  @@index([userId])
}

enum CustomFieldType {
  SELECT   // Pick from options list (e.g. S/M/L)
  BOOLEAN  // Yes / No
}

// ============================================================================
// EVENT ORGANIZER / STAFF / INVITE MODELS
// ============================================================================

model EventOrganizer {
  id        String             @id @default(cuid())
  eventId   String
  userId    String
  role      EventOrganizerRole @default(ADMIN)
  addedById String // Platform Admin or OWNER who added this person
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User  @relation("EventOrganizerUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User  @relation("EventOrganizerAddedBy", fields: [addedById], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([role])
}

model EventStaffMember {
  id        String         @id @default(cuid())
  eventId   String
  userId    String
  role      EventStaffRole @default(STAFF)
  addedById String // Organizer (OWNER/ADMIN) who added this person
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User  @relation("EventStaffMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User  @relation("EventStaffMemberAddedBy", fields: [addedById], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model EventInvite {
  id          String            @id @default(cuid())
  eventId     String
  invitedById String
  email       String // Invited by email (user may not exist yet)
  role        String // EventOrganizerRole or EventStaffRole value
  type        EventInviteType
  status      EventInviteStatus @default(PENDING)
  token       String            @unique @default(cuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("EventInvitedBy", fields: [invitedById], references: [id])

  @@index([eventId])
  @@index([email])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
}

model Result {
  id               String   @id @default(cuid())
  userId           String
  eventId          String
  variantId        String?
  time             String // Format: "HH:MM:SS" or "MM:SS"
  timeSeconds      Int? // Total time in seconds for calculations
  position         Int? // Overall position
  categoryPosition Int? // Position in category/age group
  notes            String?
  isPublic         Boolean  @default(true) // Show on public profile
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  event            Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant          EventVariant?         @relation(fields: [variantId], references: [id])
  performanceEntry UserPerformanceEntry? @relation("ResultPerformance")

  @@unique([userId, eventId, variantId]) // One result per user per variant
  @@index([userId])
  @@index([eventId])
  @@index([userId, createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  userId    String
  eventId   String
  parentId  String?
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([parentId])
}

model Post {
  id         String        @id @default(cuid())
  userId     String
  eventId    String?
  content    String
  imageUrl   String?
  mediaType  String?       @default("image") // "image" or "video"
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  isAutoPost Boolean       @default(false)
  venueId    String?
  isPublic   Boolean       @default(false)
  // WOD Post fields
  workoutId  String? // Reference to workout for WOD posts
  sessionId  String? // Reference to venue session (optional context)
  postType   PostType      @default(STANDARD) // Type of post (STANDARD, WOD, etc.)
  event      Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue      Venue?        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  workout    Workout?      @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  comments   PostComment[]
  likes      PostLike[]

  @@index([userId])
  @@index([eventId])
  @@index([venueId])
  @@index([createdAt])
  @@index([isPublic])
  @@index([workoutId])
  @@index([postType])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model ProfilePhoto {
  id        String   @id @default(cuid())
  userId    String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Friendship {
  id         String           @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  receiver   User             @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User             @relation("FriendshipSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model InstagramPostDraft {
  id          String          @id @default(cuid())
  userId      String
  templateKey String
  format      InstagramFormat @default(SQUARE)
  payload     Json
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  type      String   @default("other")
  subject   String
  message   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

// Admin notes submitted via Athli chat (event/venue submission requests)
