# ============================================================================
# Athlifyr Live Server — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================================

# Server
LIVE_PORT=4000
LIVE_HOST=0.0.0.0
NODE_ENV=development

# CORS — comma-separated list of allowed origins
LIVE_CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Redis
# - Desenvolvimento local (sem Docker): redis://localhost:6379
# - Desenvolvimento com Docker Compose:  redis://redis:6379  (nome do serviço)
# - Railway (produção): injetado automaticamente pelo serviço Redis do Railway
REDIS_URL=redis://localhost:6379

# JWT — must match the secret used by the Next.js app (NEXTAUTH_SECRET)
NEXTAUTH_SECRET=your-super-secret-jwt-key-here

# Next.js API URL — all DB operations are proxied through here
NEXT_API_URL=http://localhost:3000
