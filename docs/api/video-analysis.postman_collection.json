            },
            "description": "Teste de transcode WebM → MP4 via URL. Substituir test_video_url por uma URL de ficheiro .webm."
          }
        }
      ]
    },
    {
      "name": "Debug",
      "description": "Endpoints de debug e diagnóstico.",
      "item": [
        {
          "name": "Debug Detect - Railway",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "",
                  "description": "Imagem do frame (.jpg, .png)"
                },
                {
                  "key": "seed_x",
                  "value": "50",
                  "type": "text",
                  "description": "Posição X em % (0-100)"
                },
                {
                  "key": "seed_y",
                  "value": "60",
                  "type": "text",
                  "description": "Posição Y em % (0-100)"
                }
              ]
            },
            "url": {
              "raw": "{{railway_url}}/debug/detect",
              "host": ["{{railway_url}}"],
              "path": ["debug", "detect"]
            },
            "description": "Testar deteção do disco/peso numa imagem estática. Retorna JSON com coordenadas e percentagens."
          }
        },
        {
          "name": "Debug AI - Railway",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{railway_url}}/debug/ai?language=pt",
              "host": ["{{railway_url}}"],
              "path": ["debug", "ai"],
              "query": [
                {
                  "key": "language",
                  "value": "pt",
                  "description": "Língua do teste (pt, en, es, fr, de, it)"
                }
              ]
            },
            "description": "Testa se a análise AI está configurada: verifica OPENAI_API_KEY, pacote openai, e faz uma chamada de teste ao modelo."
          }
        },
        {
          "name": "Debug AI (EN) - Railway",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{railway_url}}/debug/ai?language=en",
              "host": ["{{railway_url}}"],
              "path": ["debug", "ai"],
              "query": [
                {
                  "key": "language",
                  "value": "en",
                  "description": "Teste em inglês"
                }
              ]
            },
            "description": "Testa AI com resposta em inglês."
          }
        }
      ]
    },
    {
      "name": "Download",
      "item": [
        {
          "name": "Download - Railway",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{railway_url}}/download/filename.mp4",
              "host": ["{{railway_url}}"],
              "path": ["download", "filename.mp4"]
            },
            "description": "Download do vídeo processado. Substituir 'filename.mp4' pelo valor de video_url da resposta."
          }
        }
      ]
    }
  ]
}
